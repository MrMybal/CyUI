* text=auto eol=lf
*.md text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.py text eol=lf
*.bat text eol=crlf
# Unified diff context adds a space before original tabs and blank lines.
tools/patches/*.patch text eol=lf whitespace=-space-before-tab,-blank-at-eol
.githooks/* text eol=lf
*.png binary
*.jpg binary
*.bmp binary
# Keep the bundled dependency byte-for-byte.
third_party/imgui/** -text !eol
third_party/texteditor/** -text !eol whitespace=cr-at-eol
# Preserve the example dependencies and upstream license byte-for-byte.
third_party/imgui-sdl3/** -text !eol -whitespace
third_party/stb/** -text !eol -whitespace
examples/markdown/SDL-LICENSE.txt -text !eol -whitespace
