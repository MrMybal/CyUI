+Sci_Position SkipTrivia(StyleContext &sc, Sci_Position offset) {
+	for (;;) {
+		while (isspacechar(sc.GetRelative(offset))) ++offset;
+		if (sc.GetRelative(offset) != '/' || sc.GetRelative(offset + 1) != '/') return offset;
+		offset += 2;
+		while (const int ch = sc.GetRelative(offset)) {
+			if (ch == '\r' || ch == '\n') break;
+			++offset;
+		}
+	}
+}
+
+int ZigNameStyle(StyleContext &sc, Sci_Position offset = 0) {
+	offset = SkipTrivia(sc, offset);
+	if (sc.GetRelative(offset) == '(') return SCE_ZIG_FUNCTION;
+	if (sc.GetRelative(offset) == '=') {
+		offset = SkipTrivia(sc, offset + 1);
+		for (const std::string_view kind : {"struct", "enum", "union", "opaque", "packed", "extern"}) {
+			Sci_Position next = offset;
+			for (char ch : kind) {
+				if (sc.GetRelative(next) != ch) break;
+				++next;
+			}
+			if (next - offset == static_cast<Sci_Position>(kind.size()) && !IsIdentifierChar(sc.GetRelative(next)))
+				return SCE_ZIG_KW_TYPE;
+		}
+	}
+	return SCE_ZIG_IDENTIFIER;
 }
 
